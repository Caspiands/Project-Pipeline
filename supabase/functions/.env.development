# LOCAL DEVELOPMENT ONLY. Used by `npm run functions:serve` and by CI. Never use these values in production.
#
# With RESEND_API_KEY unset and MFA_DEV_LOG_CODES=true, mfa-send does not email the code; it prints it
# to the function console instead:   [dev] sign-in code for admin@caspiands.com: 123456
# Read it with `npm run functions:logs` or in the terminal running `npm run functions:serve`.
MFA_DEV_LOG_CODES=true

# Dev-only pepper (64 hex characters). Production uses its own secret from `openssl rand -hex 32`.
MFA_PEPPER=6f1d2a9c4b8e7f30515a6c2d9e8b7a4f3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f

MFA_FROM_EMAIL="CDS Pipeline <no-reply@caspiands.com>"
MFA_CODE_MINUTES=10
MFA_SESSION_HOURS=12

# Where invite emails send people locally, and the only browser origin allowed to call the functions.
SITE_URL=http://127.0.0.1:5917/set-password
ALLOWED_EMAIL_DOMAINS=caspiands.com
ALLOWED_ORIGIN=http://127.0.0.1:5917
