# Secrets for the Edge Functions. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Brevo (https://www.brevo.com) API key — used for sign-in codes when set (preferred in production).
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend (https://resend.com) API key — fallback when BREVO_API_KEY is not set.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender on the code email. Must be a sender verified in Brevo when using BREVO_API_KEY.
MFA_FROM_EMAIL=Caspian Digital Solutions <bhargava@caspiands.com>

# Random secret mixed into stored code hashes. At least 32 characters.
# Generate one with:  openssl rand -hex 32
MFA_PEPPER=replace-with-64-random-hex-characters

# How long a code is valid, and how long a verified session lasts
MFA_CODE_MINUTES=10
MFA_SESSION_HOURS=12

# Where invite emails send people (your deployed app URL)
SITE_URL=https://pipeline.caspiands.com

# Lock invites and CORS to your company
ALLOWED_EMAIL_DOMAINS=caspiands.com
ALLOWED_ORIGIN=https://pipeline.caspiands.com
