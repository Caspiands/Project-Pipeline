-- Shared set-up for the policy tests. Included from each test with \ir so it runs inside that
-- test's transaction and is rolled back with it. Nothing here survives the test.
--
-- It creates six logins (through auth.users, so the real new-user trigger makes the profiles),
-- marks the sessions that have passed the emailed code, and adds one opportunity to read.
--
-- Login ids are fixed so the tests can refer to them:
--   1 admin        verified session, role admin
--   2 editor       verified session, role editor
--   3 viewer       verified session, role viewer
--   4 deactivated  verified session, role editor, is_active = false
--   5 unverified   signed in, no verified session
--   6 expired      verified session that ran out a minute ago, role editor

create extension if not exists pgtap with schema extensions;

insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
                        raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
select ('00000000-0000-4000-8000-00000000000' || n)::uuid,
       '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
       label || '@policy-test.local', '', now(),
       '{"provider":"email","providers":["email"]}'::jsonb, jsonb_build_object('full_name', label), now(), now()
from (values (1, 'admin'), (2, 'editor'), (3, 'viewer'), (4, 'deactivated'), (5, 'unverified'), (6, 'expired')) as t(n, label);

update public.profiles set role = 'admin'  where id = '00000000-0000-4000-8000-000000000001';
update public.profiles set role = 'editor' where id in ('00000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000004', '00000000-0000-4000-8000-000000000006');
update public.profiles set role = 'viewer' where id in ('00000000-0000-4000-8000-000000000003', '00000000-0000-4000-8000-000000000005');
update public.profiles set is_active = false where id = '00000000-0000-4000-8000-000000000004';

insert into public.mfa_verified_sessions (session_id, user_id, expires_at) values
  ('10000000-0000-4000-8000-000000000001', '00000000-0000-4000-8000-000000000001', now() + interval '1 hour'),
  ('10000000-0000-4000-8000-000000000002', '00000000-0000-4000-8000-000000000002', now() + interval '1 hour'),
  ('10000000-0000-4000-8000-000000000003', '00000000-0000-4000-8000-000000000003', now() + interval '1 hour'),
  ('10000000-0000-4000-8000-000000000004', '00000000-0000-4000-8000-000000000004', now() + interval '1 hour'),
  ('10000000-0000-4000-8000-000000000006', '00000000-0000-4000-8000-000000000006', now() - interval '1 minute');

-- One row of each kind so "can read" checks do not depend on the seed data.
insert into public.people (id, name) values ('30000000-0000-4000-8000-000000000001', 'Policy test owner');
insert into public.commitments (person_id, year, amount) values ('30000000-0000-4000-8000-000000000001', 2026, 1000);
insert into public.opportunities (id, account, item, owner_id, stage, value, revenue_year)
values ('20000000-0000-4000-8000-000000000001', 'Policy test account', 'Policy test item', '30000000-0000-4000-8000-000000000001', 'Lead', 1000, 2026);
insert into public.prospects (id, company) values ('40000000-0000-4000-8000-000000000001', 'Policy test prospect');
insert into public.settings (id) values (1) on conflict (id) do nothing;

-- Pretend to be a login. Sets the JWT claims PostgREST would set, then switches to the
-- `authenticated` database role so Row Level Security applies exactly as it does for the app.
create function pg_temp.login(p_user int, p_session int default null) returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', format(
    '{"sub":"00000000-0000-4000-8000-00000000000%s","role":"authenticated","session_id":"10000000-0000-4000-8000-00000000000%s"}',
    p_user, coalesce(p_session, p_user)), true);
  execute 'set local role authenticated';
end $$;

-- Pretend to be a signed-out visitor (the anon key with no session).
create function pg_temp.anon() returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
  execute 'set local role anon';
end $$;

-- Back to the superuser-like `postgres` role for assertions that look behind the policies.
create function pg_temp.logout() returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
end $$;

-- Runs an update or delete and reports how many rows it touched. Row Level Security hides rows
-- from updates and deletes silently (no error, zero rows), so "cannot change" tests check for 0.
create function pg_temp.rows_changed(p_sql text) returns bigint language plpgsql as $$
declare n bigint;
begin
  execute p_sql;
  get diagnostics n = row_count;
  return n;
end $$;

-- Row counts the policies expose, as one text summary for easy comparison.
create function pg_temp.visible_counts() returns text language sql as $$
  select format('profiles=%s people=%s settings=%s commitments=%s opportunities=%s stage_history=%s prospects=%s reviews=%s audit_log=%s',
    (select count(*) from public.profiles), (select count(*) from public.people), (select count(*) from public.settings),
    (select count(*) from public.commitments), (select count(*) from public.opportunities), (select count(*) from public.stage_history),
    (select count(*) from public.prospects), (select count(*) from public.reviews), (select count(*) from public.audit_log))
$$;
