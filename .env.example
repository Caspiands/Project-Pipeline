# Copy to .env.local for local development (never commit .env.local).
#
# --- Local (npm run dev on port 5917) ---
# Vite proxies /auth, /rest, /realtime, /functions to Kong on 54321.
# Run `npm run db:env` after `supabase start` to fill the anon key from the local stack.
VITE_SUPABASE_URL=http://127.0.0.1:5917
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status
#
# --- Production (set only in Vercel → Environment Variables, not in the repo) ---
# VITE_SUPABASE_URL=https://imcwrdhyfwgzcecrhvwj.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-publishable-key-from-supabase-project-settings-api
#
# Never put the service-role key in the frontend or in git.
