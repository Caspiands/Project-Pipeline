# Copy to .env.local (never commit .env.local).
# Values for the local stack are printed by `npx supabase start` / `npx supabase status`.
# For production use Supabase → Project Settings → API. Use the anon (public) key only;
# the service-role key must never appear in the frontend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-anon-key
